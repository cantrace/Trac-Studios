{
  "version": 2,
  "cleanUrls": false,
  "rewrites": [
    {
      "source": "/Counter-Strike-master/assets/:match*",
      "destination": "/Counter-Strike-master/www/assets/:match*"
    },
    {
      "source": "/Counter-Strike-master/resources/:match*",
      "destination": "/Counter-Strike-master/www/resources/:match*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}
